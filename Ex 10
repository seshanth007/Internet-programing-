<?php
if ($_SERVER["REQUEST_METHOD"] == "POST") {
 $username = trim($_POST['username'] ?? '');
 $email = trim($_POST['email'] ?? '');
 $password = $_POST['password'] ?? '';
 $course_code = trim($_POST['course_code'] ?? '');
 $phone = trim($_POST['phone'] ?? '');
 $role = trim($_POST['role'] ?? '');
 $errors = [];
 if (!preg_match("/^[a-zA-Z0-9_]{3,20}$/", $username)) {
 $errors[] = "Invalid username.";
 }
 if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
 $errors[] = "Invalid email.";
 }
 if (!preg_match("/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/", $password)) {
 $errors[] = "Invalid password.";
 }
 if (!preg_match("/^[A-Z]{3}-\d{3}$/", $course_code)) {
 $errors[] = "Invalid course code.";
 }
 if (!preg_match("/^\+\d{10}$/", $phone)) {
 $errors[] = "Invalid phone number (must start with '+' followed by 10-15 digits).";
 }
 if (!in_array($role, ['student', 'teacher'])) {
 $errors[] = "Please select a valid role.";
 }
 if (!empty($errors)) {
 foreach ($errors as $error) {
 echo "<p style='color:red;'>$error</p>";
 }
 echo '<br><a href="index.html">&laquo; Go Back</a>';
 } else {
 echo "<h3 style='color:green;'>Registration Successful!</h3>";
 echo "<p>Welcome, " . htmlspecialchars($username) . " (" . htmlspecialchars($role) . ")!</p>";
 }
} else {
 header("Location: index.html");
 exit();
}
?>
