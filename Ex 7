import java.io.IOException;
import java.io.PrintWriter;
import java.util.HashMap;
import java.util.Map;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;
@WebServlet("/Servlet1")
public class Servlet1 extends HttpServlet {
    // A simple in-memory map to track submission counts across sessions by company name
   private static final Map<String, Integer> nameCountMap = new HashMap<>();
 protected void doPost(HttpServletRequest request, HttpServletResponse response)
           throws ServletException, IOException {
       response.setContentType("text/html");
        PrintWriter out = response.getWriter();
        String name = request.getParameter("compName");
        String est = request.getParameter("compEst");
        String type = request.getParameter("compType");
        String industry = request.getParameter("compIndustry");
        String employees = request.getParameter("compEmployees");
        String email = request.getParameter("compMail");
        String city = request.getParameter("compCity");
         HttpSession session = request.getSession();
        synchronized (nameCountMap) {
            int count = nameCountMap.getOrDefault(name, 0) + 1;
            nameCountMap.put(name, count);
            // Store the count in the session
            session.setAttribute("companySessionCount", count);
        }
       out.println("<html>");
        out.println("<body>");
        out.println("<h2>Welcome, " + name + "</h2>");
        out.println("<p>Choose a Session Tracking Method:</p>");
        // 1. Hidden Form Field (Points to Servlet3)
        out.println("<form action='Servlet3' method='post'>");
        out.println("<input type='hidden' name='compName' value='" + name + "'>");
        out.println("<input type='hidden' name='compEst' value='" + est + "'>");
        out.println("<input type='hidden' name='compType' value='" + type + "'>");
        out.println("<input type='hidden' name='compIndustry' value='" + industry + "'>");
        out.println("<input type='hidden' name='compEmployees' value='" + employees + "'>");
        out.println("<input type='hidden' name='compMail' value='" + email + "'>");
        out.println("<input type='hidden' name='compCity' value='" + city + "'>");
        out.println("<input type='submit' value='Visit using Hidden Fields'>");
        out.println("</form>");
        out.println("<br>");
        // 2. URL Rewriting (Points to Servlet3 via GET request)
        out.println("<a href='Servlet3"
                + "?compName=" + name
                + "&compEst=" + est
                + "&compType=" + type
                + "&compIndustry=" + industry
                + "&compEmployees=" + employees
                + "&compMail=" + email
                + "&compCity=" + city
                + "'>");
        out.println("Visit using URL Rewriting");
        out.println("</a>");
        out.println("</body>");
        out.println("</html>");
   }
}
