import java.io.IOException;
import java.io.PrintWriter;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

@WebServlet("/Servlet3")
public class Servlet3 extends HttpServlet {
   protected void doPost(HttpServletRequest request, HttpServletResponse response)
           throws ServletException, IOException {
        displayDetails(request, response);
   } 
   protected void doGet(HttpServletRequest request, HttpServletResponse response)
           throws ServletException, IOException {
        displayDetails(request, response);
   }
   private void displayDetails(HttpServletRequest request, HttpServletResponse response)
           throws IOException {
        response.setContentType("text/html");
        PrintWriter out = response.getWriter();
        
        String name = request.getParameter("compName");
        String est = request.getParameter("compEst");
        String type = request.getParameter("compType");
        String industry = request.getParameter("compIndustry");
        String employees = request.getParameter("compEmployees");
        String email = request.getParameter("compMail");
        String city = request.getParameter("compCity");
        
        // Retrieve submission count from session
        HttpSession session = request.getSession(false);
        int count = 1;
        if (session != null && session.getAttribute("companySessionCount") != null) {
            count = (int) session.getAttribute("companySessionCount");
        }
        out.println("<html>");
        out.println("<body>");
        out.println("<h2>Company Details</h2>");
        out.println("Company Name: " + name + "<br><br>");
        out.println("Established Year: " + est + "<br><br>");
        out.println("Type: " + type + "<br><br>");
        out.println("Industry: " + industry + "<br><br>");
        out.println("Employees: " + employees + "<br><br>");
        out.println("Email: " + email + "<br><br>");
        out.println("City: " + city + "<br><br>");
        
        // Display the submission count
        out.println("<h3>Submission Count for " + name + ": " + count + "</h3>");
        out.println("<h3>Session Tracking Successful!</h3>");
        out.println("</body>");
        out.println("</html>");

